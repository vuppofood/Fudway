{
  "expo": {
    "name": "Delivery Mobile",
    "slug": "delivery-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "delivery-mobile",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/fudway_logo_white_transparent.png",
      "imageWidth": 280,
      "resizeMode": "contain",
      "backgroundColor": "#05462B"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.vuppofood.vuppo"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fudway_logo_white_transparent.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#05462B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "47b2e503-2c60-43af-b7e4-14fa4e2be4ff"
      }
    },
    "owner": "vuppofood"
  }
}
